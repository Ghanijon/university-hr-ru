# XAMPP: если открыть http://localhost/university-hr/ (корень проекта, а не public/),
# все запросы перенаправляются внутрь public/. Так config/, src/, database/
# не видны из браузера. На рабочем сервере DocumentRoot сразу указывает на public/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
